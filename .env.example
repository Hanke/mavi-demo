# Copy to .env and fill in secrets. Every value has a working default for local dev
# except the provider API keys.

# --- Postgres (pgvector) ---
POSTGRES_USER=mavi
POSTGRES_PASSWORD=mavi
POSTGRES_DB=mavi
POSTGRES_PORT=5433
# Used by `make migrate` / `make seed` from the host.
DATABASE_URL=postgres://mavi:mavi@localhost:5433/mavi?sslmode=disable

# --- LLM provider ---
# anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
# openai | local (deterministic stub, no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Host ports ---
API_PORT=8080
AI_PORT=8000
WEB_PORT=5173
