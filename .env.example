# Copy to .env and fill in secrets. Every value has a working default for local dev
# except the provider API keys.

# --- Postgres (pgvector) ---
POSTGRES_USER=mavi
POSTGRES_PASSWORD=mavi
POSTGRES_DB=mavi
POSTGRES_PORT=5433
# The compose database as seen from the host: `make test-db` runs the Go tests against it, and
# a service run outside Docker connects with it. (`make migrate` and `make seed` run inside the
# api container and use compose's own URL.)
DATABASE_URL=postgres://mavi:mavi@localhost:5433/mavi?sslmode=disable

# --- LLM provider ---
# anthropic | openai | fake (deterministic heuristics, no key needed; see ai/app/fake.py)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Chat model for /parse-resume, /parse-jd and /rerank. Empty picks the provider default
# in ai/app/llm.py (claude-opus-5-5 for anthropic).
LLM_MODEL=

# --- Embeddings ---
# openai | local (deterministic stub, no key needed)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Response cache ---
# LLM and embedding responses are kept on disk, keyed on a hash of model, prompt and input.
# on | off (bypass: never read or write) | refresh (call the provider and overwrite)
AI_CACHE=on
# Empty means ai/.cache. Read only by an AI service run outside Docker: under compose the cache
# is always the ai_cache volume.
AI_CACHE_DIR=

# --- Matching ---
# How many of the candidates who pass a role's hard filters are retrieved by embedding
# similarity for the rerank (1 to 50).
MATCH_RETRIEVAL_SIZE=20
# How many of a matching run's ranking, from the top, go to ops as pending_review (1 to 50).
MATCH_REVIEW_SIZE=5
# The least a candidate may score in the rerank (above 0, at most 1) and still go to the review queue. A run
# with fewer than two at or above it completes as needs_attention.
MATCH_MIN_SCORE=0.6

# --- Background jobs ---
# Jobs run by the worker inside the API container; 0 disables it (then run `make worker`).
WORKER_CONCURRENCY=2
# How long a job may stay running before another worker takes it for abandoned (a Go duration;
# empty is 5m). Longer than the slowest job, or a live job is run twice.
WORKER_LOCK_TIMEOUT=

# --- Host ports ---
API_PORT=8080
AI_PORT=8000
WEB_PORT=5173
