{
  "components": {
    "schemas": {
      "CandidateProfile": {
        "additionalProperties": false,
        "description": "What the resume parser extracts. Maps onto candidate_profiles.",
        "properties": {
          "availability": {
            "default": "unknown",
            "enum": [
              "immediate",
              "two_weeks",
              "one_month",
              "unavailable",
              "unknown"
            ],
            "title": "Availability",
            "type": "string"
          },
          "available_from": {
            "default": null,
            "format": "date",
            "nullable": true,
            "title": "Available From",
            "type": "string"
          },
          "certifications": {
            "description": "Certifications the candidate holds, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "headline": {
            "default": null,
            "description": "One-line summary of the candidate, e.g. 'Senior Accountant'.",
            "nullable": true,
            "title": "Headline",
            "type": "string"
          },
          "industries": {
            "description": "Industries the candidate has worked in, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "languages": {
            "description": "Spoken languages as ISO 639-1 codes.",
            "items": {
              "type": "string"
            },
            "title": "Languages",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_certifications": {
            "description": "Certifications not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_industries": {
            "description": "Industries not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_software": {
            "description": "Software not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "skills": {
            "description": "Free-text skills, e.g. 'month-end close'.",
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "software": {
            "description": "Software the candidate has used, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "timezone": {
            "default": null,
            "description": "IANA name, e.g. America/Chicago.",
            "nullable": true,
            "title": "Timezone",
            "type": "string"
          },
          "years_experience": {
            "default": null,
            "maximum": 70,
            "minimum": 0,
            "nullable": true,
            "title": "Years Experience",
            "type": "integer"
          }
        },
        "title": "CandidateProfile",
        "type": "object"
      },
      "Contact": {
        "additionalProperties": false,
        "description": "Header details the resume parser returns alongside the profile.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "location": {
            "nullable": true,
            "title": "Location",
            "type": "string"
          },
          "phone": {
            "nullable": true,
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "email"
        ],
        "title": "Contact",
        "type": "object"
      },
      "EmbedRequest": {
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dim": {
            "title": "Dim",
            "type": "integer"
          },
          "embedding": {
            "items": {
              "type": "number"
            },
            "title": "Embedding",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "embedding",
          "dim",
          "provider"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "embedding_provider": {
            "title": "Embedding Provider",
            "type": "string"
          },
          "llm_provider": {
            "title": "Llm Provider",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "llm_provider",
          "embedding_provider"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ParseJDRequest": {
        "properties": {
          "text": {
            "description": "The job description as plain text.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseJDRequest",
        "type": "object"
      },
      "ParseJDResponse": {
        "properties": {
          "company": {
            "nullable": true,
            "title": "Company",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "requirements": {
            "$ref": "#/components/schemas/RoleRequirements"
          }
        },
        "required": [
          "company",
          "requirements",
          "provider"
        ],
        "title": "ParseJDResponse",
        "type": "object"
      },
      "ParseResumeRequest": {
        "properties": {
          "as_of": {
            "description": "The date years_experience is counted to. Default: today.",
            "format": "date",
            "nullable": true,
            "title": "As Of",
            "type": "string"
          },
          "text": {
            "description": "The resume as plain text.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseResumeRequest",
        "type": "object"
      },
      "ParseResumeResponse": {
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "profile": {
            "$ref": "#/components/schemas/CandidateProfile"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "contact",
          "profile",
          "provider"
        ],
        "title": "ParseResumeResponse",
        "type": "object"
      },
      "RerankCandidate": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Opaque id echoed back in the result.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "text": {
            "description": "Resume text or a rendered profile; whatever the model should judge.",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "RerankCandidate",
        "type": "object"
      },
      "RerankRequest": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/RerankCandidate"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Candidates",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "role": {
            "description": "The job description, or a rendering of the role.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "candidates"
        ],
        "title": "RerankRequest",
        "type": "object"
      },
      "RerankResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "results": {
            "description": "Every candidate, best first.",
            "items": {
              "$ref": "#/components/schemas/RerankResult"
            },
            "title": "Results",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "required": [
          "results",
          "provider"
        ],
        "title": "RerankResponse",
        "type": "object"
      },
      "RerankResult": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "score"
        ],
        "title": "RerankResult",
        "type": "object"
      },
      "RoleRequirements": {
        "additionalProperties": false,
        "description": "What the JD parser extracts. Maps onto roles.",
        "properties": {
          "industries": {
            "description": "Industry context of the role, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "must_haves": {
            "description": "Every hard requirement in the JD's own words.",
            "items": {
              "type": "string"
            },
            "title": "Must Haves",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "nice_to_haves": {
            "description": "Preferred but not required, in the JD's own words.",
            "items": {
              "type": "string"
            },
            "title": "Nice To Haves",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_industries": {
            "description": "Industries not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_required_certifications": {
            "description": "Required certifications not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Required Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_required_software": {
            "description": "Required software not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Required Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "required_certifications": {
            "description": "Certifications the role requires, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Required Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "required_software": {
            "description": "Software the role requires, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Required Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "starts_on": {
            "default": null,
            "format": "date",
            "nullable": true,
            "title": "Starts On",
            "type": "string"
          },
          "timezone": {
            "default": null,
            "description": "IANA name the role operates in.",
            "nullable": true,
            "title": "Timezone",
            "type": "string"
          },
          "title": {
            "default": null,
            "nullable": true,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "RoleRequirements",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Mavi AI",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/embed": {
      "post": {
        "operationId": "embed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Embed"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/parse-jd": {
      "post": {
        "operationId": "parse_jd",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseJDRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseJDResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parse Jd"
      }
    },
    "/parse-resume": {
      "post": {
        "operationId": "parse_resume",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseResumeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResumeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Parse Resume"
      }
    },
    "/rerank": {
      "post": {
        "operationId": "rerank",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RerankResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rerank"
      }
    }
  }
}
