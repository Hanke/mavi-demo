{
  "components": {
    "schemas": {
      "CandidateProfile": {
        "additionalProperties": false,
        "description": "What the resume parser extracts. Maps onto candidate_profiles.",
        "properties": {
          "availability": {
            "default": "unknown",
            "enum": [
              "immediate",
              "two_weeks",
              "one_month",
              "unavailable",
              "unknown"
            ],
            "title": "Availability",
            "type": "string"
          },
          "available_from": {
            "default": null,
            "format": "date",
            "nullable": true,
            "title": "Available From",
            "type": "string"
          },
          "certifications": {
            "description": "Certifications the candidate holds, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "gaap_exposure": {
            "description": "Accounting frameworks and standards the resume names, e.g. 'US GAAP', 'ASC 606', 'IFRS 17'.",
            "items": {
              "type": "string"
            },
            "title": "Gaap Exposure",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "headline": {
            "default": null,
            "description": "One-line summary of the candidate, e.g. 'Senior Accountant'.",
            "nullable": true,
            "title": "Headline",
            "type": "string"
          },
          "industries": {
            "description": "Industries the candidate has worked in, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "languages": {
            "description": "Spoken languages as ISO 639-1 codes.",
            "items": {
              "type": "string"
            },
            "title": "Languages",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_certifications": {
            "description": "Certifications not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Certifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_industries": {
            "description": "Industries not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_software": {
            "description": "Software not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
            "title": "Other Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "positions": {
            "description": "Jobs held, in the order the resume lists them.",
            "items": {
              "$ref": "#/components/schemas/Position"
            },
            "title": "Positions",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "qualifications": {
            "description": "Every professional qualification the resume mentions, held or not, as written.",
            "items": {
              "$ref": "#/components/schemas/Qualification"
            },
            "title": "Qualifications",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "skills": {
            "description": "Free-text skills, e.g. 'month-end close'.",
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "software": {
            "description": "Software the candidate has used, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Software",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "timezone": {
            "default": null,
            "description": "IANA name, e.g. America/Chicago.",
            "nullable": true,
            "title": "Timezone",
            "type": "string"
          },
          "years_experience": {
            "default": null,
            "maximum": 70,
            "minimum": 0,
            "nullable": true,
            "title": "Years Experience",
            "type": "integer"
          }
        },
        "title": "CandidateProfile",
        "type": "object"
      },
      "Contact": {
        "additionalProperties": false,
        "description": "Header details the resume parser returns alongside the profile.\n\nEvery field is nullable: a resume with no email gets null, not a made-up\naddress, and a blank string from the model means the same thing.",
        "properties": {
          "email": {
            "nullable": true,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "nullable": true,
            "title": "Full Name",
            "type": "string"
          },
          "location": {
            "nullable": true,
            "title": "Location",
            "type": "string"
          },
          "phone": {
            "nullable": true,
            "title": "Phone",
            "type": "string"
          }
        },
        "title": "Contact",
        "type": "object"
      },
      "DimensionScore": {
        "additionalProperties": false,
        "description": "A candidate's level on a dimension the rubric always scores.",
        "properties": {
          "evidence": {
            "description": "One sentence: what in the candidate's text decides the level.",
            "title": "Evidence",
            "type": "string"
          },
          "level": {
            "description": "The rubric level, 0 (none) to 4 (full).",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "title": "Level",
            "type": "integer"
          },
          "quotes": {
            "description": "Passages copied verbatim from the candidate's text that back the level, at most 3; empty when the level is 0 or null. In a response, each is a substring of that text.",
            "items": {
              "type": "string"
            },
            "title": "Quotes",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "required": [
          "evidence",
          "quotes",
          "level"
        ],
        "title": "DimensionScore",
        "type": "object"
      },
      "DimensionScores": {
        "additionalProperties": false,
        "description": "One level per dimension of the rubric (app/rubric.py, docs/rerank-rubric.md).",
        "properties": {
          "experience_depth": {
            "$ref": "#/components/schemas/DimensionScore",
            "description": "How closely does the work the candidate has actually done match the work of this role: the same function, at the same seniority and scope, recently, under the same accounting framework?"
          },
          "industry_fit": {
            "$ref": "#/components/schemas/OptionalDimensionScore",
            "description": "Has the candidate worked in the industry the role is in?"
          },
          "must_have_coverage": {
            "$ref": "#/components/schemas/OptionalDimensionScore",
            "description": "Does the candidate meet each thing the role states as required: the qualification, the years, the required software, and any other must-have? Met or not met, not how well."
          },
          "nice_to_haves": {
            "$ref": "#/components/schemas/OptionalDimensionScore",
            "description": "How many of the things the role states as preferred, a bonus or nice to have does the text show?"
          },
          "software_fluency": {
            "$ref": "#/components/schemas/OptionalDimensionScore",
            "description": "How well does the candidate know the systems the role names, required or preferred? Depth of use, not presence: a product that only appears in a list is listed, not evidenced."
          }
        },
        "required": [
          "must_have_coverage",
          "experience_depth",
          "software_fluency",
          "industry_fit",
          "nice_to_haves"
        ],
        "title": "DimensionScores",
        "type": "object"
      },
      "EmbedBatchRequest": {
        "properties": {
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/EmbedInput"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Inputs",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "required": [
          "inputs"
        ],
        "title": "EmbedBatchRequest",
        "type": "object"
      },
      "EmbedBatchResponse": {
        "properties": {
          "dim": {
            "title": "Dim",
            "type": "integer"
          },
          "embeddings": {
            "description": "One vector per input, in the order given.",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Embeddings",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "texts": {
            "description": "The text each vector was computed from, in the same order.",
            "items": {
              "type": "string"
            },
            "title": "Texts",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "required": [
          "embeddings",
          "texts",
          "dim",
          "provider"
        ],
        "title": "EmbedBatchResponse",
        "type": "object"
      },
      "EmbedInput": {
        "description": "One thing to embed: exactly one of the three fields. A profile or a\nrole's requirements is rendered to its canonical text (app/embedtext.py)\nfirst, so the two are embedded in a comparable form.",
        "properties": {
          "profile": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CandidateProfile"
              }
            ],
            "description": "Embedded as its canonical profile text.",
            "nullable": true
          },
          "requirements": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoleRequirements"
              }
            ],
            "description": "Embedded as its canonical role text.",
            "nullable": true
          },
          "text": {
            "description": "Embedded as given.",
            "maxLength": 60000,
            "minLength": 1,
            "nullable": true,
            "title": "Text",
            "type": "string"
          }
        },
        "title": "EmbedInput",
        "type": "object"
      },
      "EmbedRequest": {
        "properties": {
          "text": {
            "maxLength": 60000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dim": {
            "title": "Dim",
            "type": "integer"
          },
          "embedding": {
            "items": {
              "type": "number"
            },
            "title": "Embedding",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "embedding",
          "dim",
          "provider"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "embedding_provider": {
            "title": "Embedding Provider",
            "type": "string"
          },
          "llm_provider": {
            "title": "Llm Provider",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "llm_provider",
          "embedding_provider"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "OptionalDimensionScore": {
        "additionalProperties": false,
        "description": "A candidate's level on a dimension the role may give nothing to score against.",
        "properties": {
          "evidence": {
            "description": "One sentence: what in the candidate's text decides the level, or why the dimension is null.",
            "title": "Evidence",
            "type": "string"
          },
          "level": {
            "description": "The rubric level, 0 (none) to 4 (full); null when the dimension does not apply to the role.",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "nullable": true,
            "title": "Level",
            "type": "integer"
          },
          "quotes": {
            "description": "Passages copied verbatim from the candidate's text that back the level, at most 3; empty when the level is 0 or null. In a response, each is a substring of that text.",
            "items": {
              "type": "string"
            },
            "title": "Quotes",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          }
        },
        "required": [
          "evidence",
          "quotes",
          "level"
        ],
        "title": "OptionalDimensionScore",
        "type": "object"
      },
      "ParseJDRequest": {
        "properties": {
          "text": {
            "description": "The job description as plain text.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseJDRequest",
        "type": "object"
      },
      "ParseJDResponse": {
        "properties": {
          "company": {
            "nullable": true,
            "title": "Company",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "requirements": {
            "$ref": "#/components/schemas/RoleRequirements"
          }
        },
        "required": [
          "company",
          "requirements",
          "provider"
        ],
        "title": "ParseJDResponse",
        "type": "object"
      },
      "ParseResumeRequest": {
        "properties": {
          "as_of": {
            "description": "The date years_experience is counted to. Default: today.",
            "format": "date",
            "nullable": true,
            "title": "As Of",
            "type": "string"
          },
          "text": {
            "description": "The resume as plain text.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseResumeRequest",
        "type": "object"
      },
      "ParseResumeResponse": {
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "profile": {
            "$ref": "#/components/schemas/CandidateProfile"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "contact",
          "profile",
          "provider"
        ],
        "title": "ParseResumeResponse",
        "type": "object"
      },
      "Position": {
        "additionalProperties": false,
        "description": "One job in the candidate's work history, as the resume lists it.",
        "properties": {
          "current": {
            "default": false,
            "description": "True when the resume says the role runs to the present.",
            "title": "Current",
            "type": "boolean"
          },
          "employer": {
            "default": null,
            "description": "Employer as written; null if the resume names none.",
            "nullable": true,
            "title": "Employer",
            "type": "string"
          },
          "end_year": {
            "default": null,
            "description": "Four-digit year the role ended; null for a current role.",
            "maximum": 2100,
            "minimum": 1950,
            "nullable": true,
            "title": "End Year",
            "type": "integer"
          },
          "start_year": {
            "default": null,
            "description": "Four-digit year the role began.",
            "maximum": 2100,
            "minimum": 1950,
            "nullable": true,
            "title": "Start Year",
            "type": "integer"
          },
          "title": {
            "description": "Job title as written, e.g. 'Senior Accountant'.",
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "title": "Position",
        "type": "object"
      },
      "Qualification": {
        "additionalProperties": false,
        "description": "One professional qualification exactly as the resume gives it.\n\n`canonical` is the qualification the candidate holds, never the one a\nrole might want instead: an ACA is `aca_icaew`, not `cpa`.",
        "properties": {
          "canonical": {
            "default": null,
            "description": "Taxonomy id of this qualification itself, e.g. 'aca_icaew'; null if it is not in the taxonomy.",
            "nullable": true,
            "title": "Canonical",
            "type": "string"
          },
          "issuing_body": {
            "default": null,
            "description": "e.g. 'ICAEW', 'ACCA', 'CPA Ontario'; null if unstated.",
            "nullable": true,
            "title": "Issuing Body",
            "type": "string"
          },
          "jurisdiction": {
            "default": null,
            "description": "Where it was awarded, e.g. 'UK', 'US', 'Australia'; null if it cannot be determined.",
            "nullable": true,
            "title": "Jurisdiction",
            "type": "string"
          },
          "name_as_written": {
            "description": "Exactly what the resume says, e.g. 'ACA', 'CPA, CA'.",
            "minLength": 1,
            "title": "Name As Written",
            "type": "string"
          },
          "quote": {
            "default": null,
            "description": "The resume's own words that show it, verbatim.",
            "nullable": true,
            "title": "Quote",
            "type": "string"
          },
          "status": {
            "default": "qualified",
            "description": "qualified only when fully held; 'ACCA finalist' is part_qualified, 'studying for' in_progress.",
            "enum": [
              "qualified",
              "part_qualified",
              "in_progress"
            ],
            "title": "Status",
            "type": "string"
          },
          "year_obtained": {
            "default": null,
            "maximum": 2100,
            "minimum": 1950,
            "nullable": true,
            "title": "Year Obtained",
            "type": "integer"
          }
        },
        "required": [
          "name_as_written"
        ],
        "title": "Qualification",
        "type": "object"
      },
      "RequiredQualification": {
        "additionalProperties": false,
        "description": "One qualification a role requires, and whether an equivalent will do.",
        "properties": {
          "accept_equivalents": {
            "default": true,
            "description": "False only when the JD rules equivalents out, e.g. 'active US CPA licence required'.",
            "title": "Accept Equivalents",
            "type": "boolean"
          },
          "canonical": {
            "default": null,
            "description": "Taxonomy id of the qualification asked for; null if not in the taxonomy.",
            "nullable": true,
            "title": "Canonical",
            "type": "string"
          },
          "equivalents_stated": {
            "default": false,
            "description": "True when the JD says either way ('CPA or equivalent', 'US licence required'); false means accept_equivalents is the default and the employer should confirm it at intake.",
            "title": "Equivalents Stated",
            "type": "boolean"
          },
          "name_as_written": {
            "description": "The qualification as the JD names it, e.g. 'CPA'.",
            "minLength": 1,
            "title": "Name As Written",
            "type": "string"
          },
          "quote": {
            "default": null,
            "description": "The JD's own words, verbatim.",
            "nullable": true,
            "title": "Quote",
            "type": "string"
          }
        },
        "required": [
          "name_as_written"
        ],
        "title": "RequiredQualification",
        "type": "object"
      },
      "RerankCandidate": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Opaque id echoed back in the result.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "text": {
            "description": "Resume text or a rendered profile; whatever the model should judge.",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "RerankCandidate",
        "type": "object"
      },
      "RerankRequest": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/RerankCandidate"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Candidates",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "role": {
            "description": "The job description, or a rendering of the role.",
            "maxLength": 60000,
            "minLength": 1,
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "candidates"
        ],
        "title": "RerankRequest",
        "type": "object"
      },
      "RerankResponse": {
        "properties": {
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "results": {
            "description": "Every candidate, best first.",
            "items": {
              "$ref": "#/components/schemas/RerankResult"
            },
            "title": "Results",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "rubric_version": {
            "description": "The version of the rubric (docs/rerank-rubric.md) the scores follow.",
            "title": "Rubric Version",
            "type": "string"
          }
        },
        "required": [
          "results",
          "rubric_version",
          "provider"
        ],
        "title": "RerankResponse",
        "type": "object"
      },
      "RerankResult": {
        "additionalProperties": false,
        "properties": {
          "dimensions": {
            "$ref": "#/components/schemas/DimensionScores"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "score": {
            "description": "Computed from `dimensions` by the rubric's formula; never the model's own number.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "score",
          "dimensions"
        ],
        "title": "RerankResult",
        "type": "object"
      },
      "RoleRequirements": {
        "additionalProperties": false,
        "description": "What the JD parser extracts. Maps onto roles.\n\nRequirements come in two tiers that mirror the candidate profile. The\nmust-haves (`required_*`, `min_years_experience`, `starts_on`, `timezone`)\nare the hard filters, see HARD_FILTER_COLUMNS. The nice-to-haves\n(`preferred_*`) never exclude anyone: holding any one of them counts in a\ncandidate's favour, so \"CPP or FPC\" is simply both ids.",
        "properties": {
          "industries": {
            "description": "Industry context of the role, as taxonomy ids.",
            "items": {
              "description": "A canonical id from infra/taxonomy.json; validated at runtime.",
              "type": "string"
            },
            "title": "Industries",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "min_years_experience": {
            "default": null,
            "description": "Fewest total years of professional experience the JD accepts; null if it gives no number.",
            "maximum": 70,
            "minimum": 0,
            "nullable": true,
            "title": "Min Years Experience",
            "type": "integer"
          },
          "must_haves": {
            "description": "Every hard requirement in the JD's own words.",
            "items": {
              "type": "string"
            },
            "title": "Must Haves",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "nice_to_haves": {
            "description": "Preferred but not required, in the JD's own words.",
            "items": {
              "type": "string"
            },
            "title": "Nice To Haves",
            "type": "array",
            "x-go-type-skip-optional-pointer": true
          },
          "other_industries": {
            "description": "Industries not in the taxonomy, verbatim.",
            "items": {
              "type": "string"
            },
